{
  "manifest_version": 3,
  "name": "PS5 Pro Restock Buyer",
  "version": "1.0.0",
  "description": "Watches stores for a new PS5 Pro at list price, sold by the store itself, and checks out automatically.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "offscreen", "tabs"],
  "host_permissions": [
    "https://direct.playstation.com/*",
    "https://my.account.sony.com/*",
    "https://www.bestbuy.com/*",
    "https://www.target.com/*",
    "https://www.walmart.com/*",
    "https://www.amazon.com/*",
    "https://www.gamestop.com/*",
    "https://*.queue-it.net/*",
    "https://ntfy.sh/*",
    "https://api.pushover.net/*",
    "https://discord.com/api/webhooks/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://direct.playstation.com/*",
        "https://my.account.sony.com/*",
        "https://www.bestbuy.com/*",
        "https://www.target.com/*",
        "https://www.walmart.com/*",
        "https://www.amazon.com/*",
        "https://www.gamestop.com/*",
        "https://*.queue-it.net/*"
      ],
      "js": ["lib/config.js", "lib/detect.js", "lib/flow.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dashboard.html",
  "action": { "default_title": "PS5 Pro Restock Buyer: open dashboard" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
